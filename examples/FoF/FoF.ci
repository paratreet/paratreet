mainmodule FoF {
    extern module paratreet;
    extern module unionFindLib;
    readonly bool outputFileConfigured;
    readonly CProxy_UnionFindLib libProxy;
    readonly CProxy_Partition<CentroidData> partitionProxy;
    readonly int peanoKey;
    readonly Real linkingLength;
    readonly int periodic;
    readonly Vector3D<Real> fPeriod;
    readonly int minVerticesPerComponent; // strictly greater than

    initnode void initialize(void);

    // Registers the custom IdleStats reducer before any reduction runs.
    initnode void initIdleReducer(void);

    // Sets fof_register_traverser / fof_update_traversal_work / fof_on_resume
    // on every process so the K-trigger works on process 1 as well as process 0.
    initnode void fofHooksInit(void);

    readonly CProxy_WorkMonitor workMonitor;

    // One element per PE.  Receives point-to-point expedited messages from
    // WorkMonitorRelay to report idle time and contribute to the reduction.
    group WorkMonitor {
        entry WorkMonitor();
        entry void resetIdleTime(CkCallback cb);
        entry [expedited] void reportIdleTime(CkCallback cb, bool process_tips,
                                              bool do_parallel_help, int source_rank);
        entry [expedited] void helpSource(int source_rank);
        entry void setLocalCalcsProxy(CProxy_LocalCalcs<CentroidData> lc_proxy_);
        entry void setLocalNodeCalcsProxy(CProxy_LocalNodeCalcs<CentroidData> lnc_proxy_);
    };

    // One element per process.  Receives an expedited broadcast from the
    // coordinator and fans out point-to-point expedited sends to every
    // WorkMonitor PE element on this process.
    nodegroup WorkMonitorRelay {
        entry WorkMonitorRelay();
        entry void init(CProxy_WorkMonitor wm);
        entry [expedited] void relayReport(CkCallback cb, bool process_tips,
                                           bool do_parallel_help);
    };

    // Singleton coordinator chare that drives the periodic
    // broadcast → reduction cycle during the FoF traversal phase.
    chare IdleMonitorCoordinator {
        entry IdleMonitorCoordinator();
        entry void start(CProxy_WorkMonitor p, CProxy_WorkMonitorRelay relay);
        entry void stop();
        entry void receiveIdleTimes(CkReductionMsg* msg);
    };

    extern entry void Partition<CentroidData> startDown<FoFVisitor> (FoFVisitor v);
}