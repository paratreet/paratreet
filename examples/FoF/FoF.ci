mainmodule FoF {
    extern module paratreet;
    extern module unionFindLib;
    readonly bool outputFileConfigured;
    readonly CProxy_UnionFindLib libProxy;
    readonly CProxy_Partition<CentroidData> partitionProxy;
    readonly int peanoKey;
    readonly Real linkingLength;
    readonly int periodic;
    readonly Vector3D<Real> fPeriod;
    readonly int minVerticesPerComponent; // strictly greater than

    initnode void initialize(void);

    // Registers the custom IdleReport reducer before any reduction runs.
    initnode void initIdleReducer(void);

    // One element per PE.  Receives a broadcast to report the idle time of
    // this PE's thread, then contributes to a reduction back to the coordinator.
    group WorkMonitor {
        entry WorkMonitor();
        entry void resetIdleTime(CkCallback cb);
        entry void reportIdleTime(CkCallback cb, bool process_tips);
        entry void setLocalCalcsProxy(CProxy_LocalCalcs<CentroidData> lc_proxy_);
    };

    // Singleton coordinator chare that drives the periodic
    // broadcast → reduction cycle during the FoF traversal phase.
    chare IdleMonitorCoordinator {
        entry IdleMonitorCoordinator();
        entry void start(CProxy_WorkMonitor p);
        entry void stop();
        entry void receiveIdleTimes(CkReductionMsg* msg);
    };

    extern entry void Partition<CentroidData> startDown<FoFVisitor> (FoFVisitor v);
}